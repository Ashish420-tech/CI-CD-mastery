aws_region         = "ap-south-1"
environment        = "devops-lab"
cluster_name       = "ci-cd-mastery-eks"
kubernetes_version = "1.34"

node_instance_types = ["c7i-flex.large"]

node_min_size     = 3
node_desired_size = 3
node_max_size     = 6

enable_nat_gateway  = true
enable_cluster_logs = true
enable_ecr          = true
